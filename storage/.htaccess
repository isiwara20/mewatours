# Protect storage files and prevent PHP script execution
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Disable PHP execution completely
<IfModule mod_php.c>
    Engine off
</IfModule>
<IfModule mod_php7.c>
    Engine off
</IfModule>
<IfModule mod_php8.c>
    Engine off
</IfModule>
